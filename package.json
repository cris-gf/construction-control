{
  "name": "construction-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/domain.test.ts tests/forms.test.tsx tests/architecture.test.ts",
    "test:rules": "vitest run tests/rules.test.ts",
    "test:e2e": "playwright test",
    "emulators": "node scripts/emulators.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "seed": "node scripts/seed.mjs",
    "test:seed": "node --test tests/seed.test.mjs",
    "test:seed:integration": "node scripts/check-seed.mjs"
  },
  "dependencies": {
    "firebase": "12.2.1",
    "lucide-react": "0.542.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "firebase-tools": "15.30.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.7"
  }
}
