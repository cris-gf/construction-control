# Desarrollo: no requiere cuenta real. Host accesible desde el navegador.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=localhost
# Producción: false y configuración pública de la app web en Firebase Console.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-construction.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-construction
VITE_FIREBASE_APP_ID=demo-app

# Privadas: solo las lee el script Node; nunca agregar el prefijo VITE_.
# Producción usa .env; para emuladores crea .env.local-demo con otras credenciales.
SEED_EMAIL=
SEED_PASSWORD=
